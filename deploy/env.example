# Crapplet DCIM API configuration. Copy to /etc/crapplet-dcim/api.env (mode 0640, owner root:cdcim).
# Never commit real values. Generate secrets with the commands shown.

NODE_ENV=production
# The API listens on loopback; nginx is the only public listener.
HOST=127.0.0.1
PORT=4000

DATABASE_URL=postgres://cdcim:CHANGE_ME@127.0.0.1:5432/crapplet_dcim
DATABASE_POOL_MAX=20
# Use a password in production: redis://:CHANGE_ME@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM key ring for secrets at rest. Format: id:base64(32 bytes)[,olderId:key...]
# Generate: echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# To rotate: put the new key first and keep the old ones after it.
CDCIM_ENCRYPTION_KEYS=CHANGE_ME

# Public origin of the web UI (used for CORS if the SPA is ever served from another origin).
WEB_ORIGIN=https://dcim.example.com
# Number of reverse proxies in front of the API (1 for nginx on the same host).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Swagger UI is off in production unless enabled explicitly.
ENABLE_SWAGGER=false
